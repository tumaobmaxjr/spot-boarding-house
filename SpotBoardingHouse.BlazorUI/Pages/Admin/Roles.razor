@page "/admin/roles"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IHttpClientFactory HttpClientFactory

<h1>Roles</h1>

@if (_loading)
{
    <p>Loading...</p>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">@_error</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var role in _roles)
            {
                <tr>
                    <td>@role.Name</td>
                    <td>@role.Description</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool _loading = true;
    private string? _error;
    private List<RoleListItem> _roles = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("Api.Auth");
            var result = await client.GetFromJsonAsync<List<RoleListItem>>("api/v1/Roles");
            _roles = result ?? [];
        }
        catch
        {
            _error = "Failed to load roles.";
        }
        finally
        {
            _loading = false;
        }
    }

    private class RoleListItem
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
    }
}