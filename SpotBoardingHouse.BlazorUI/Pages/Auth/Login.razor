@page "/login"
@using SpotBoardingHouse.BlazorUI.Models.Auth
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Login | SpotBH</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-12">
    <MudPaper Elevation="4" Class="pa-6">
        <MudText Typo="Typo.h5" Class="mb-4">Sign In</MudText>

        <EditForm Model="_model" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <MudTextField @bind-Value="_model.Email"
                          Label="Email"
                          Variant="Variant.Outlined"
                          Required="true"
                          Class="mb-3" />

            <MudTextField @bind-Value="_model.Password"
                          Label="Password"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Required="true"
                          Class="mb-3" />

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
            }

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       ButtonType="ButtonType.Submit"
                       Disabled="_isSubmitting"
                       FullWidth="true">
                @(_isSubmitting ? "Signing in..." : "Login")
            </MudButton>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private readonly LoginRequest _model = new();
    private string? _error;
    private bool _isSubmitting;

    private async Task HandleLogin()
    {
        _isSubmitting = true;
        _error = null;

        var result = await AuthService.LoginAsync(_model);

        _isSubmitting = false;

        if (!result.Succeeded)
        {
            _error = result.Error;
            return;
        }

        NavigationManager.NavigateTo("/admin/users", true);
    }
}
